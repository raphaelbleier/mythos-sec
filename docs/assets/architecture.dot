// Mythos architecture — render: dot -Tsvg architecture.dot -o architecture.svg
digraph mythos {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#6d5efc", fillcolor="#f3f1ff", fontcolor="#1f2430"];
  edge [color="#6d7086", fontname="Helvetica", fontsize=9, fontcolor="#6d7086"];

  user [label="operator\n/cybersecurity <target> --scope file", fillcolor="#e0f7fb", color="#22d3ee"];

  cc [label="agent host (OpenCode first,\nClaude Code second)\n= the agent\n(reason → run tool → observe)", fillcolor="#efeaff", color="#6d5efc"];

  subgraph cluster_skills {
    label="phase skills (playbooks)"; style="rounded,dashed"; color="#8b93a7"; fontname="Helvetica";
    setup   [label="engagement-setup\nscope.yaml (single human gate)"];
    recon   [label="recon\nwhatweb · subfinder\nkatana · arjun · ffuf"];
    scan    [label="web-scan\nnuclei · dalfox · sqlmap\nmanual checks · passive\n+ auth-session · business-logic\nstored-xss-oast · deep-server"];
    exploit [label="exploit\nminimal PoC · OOB\n(if allow_exploit)"];
    report  [label="report\nclosure states\nbounty-format report.md"];
  }

  subgraph cluster_agents {
    label="sub-agents (model: inherit)"; style="rounded,dashed"; color="#8b93a7"; fontname="Helvetica";
    planner [label="planner"];
    browser [label="browser\nPlaywright + Chromium\nDOM-XSS · auth flows"];
  }

  gen [label="build-hosts.py\nAGENTS.md + .opencode/ canonical,\nagents/ commands/ generated", fillcolor="#fff7e6", color="#e0a800"];
  know [label="knowledge base\nper-class playbooks\nCVE triage · chaining", fillcolor="#eafff0", color="#1faa59"];

  shim    [label="scripts/mythos\n(docker exec shim)", fillcolor="#fff7e6", color="#e0a800"];
  toolbox [label="mythos-toolbox (Kali, Docker; ghcr.io image or local build)\nnuclei · sqlmap · dalfox · ffuf · katana\nsubfinder · httpx · commix · interactsh · jwt_tool", fillcolor="#eef2ff", color="#3b5bdb"];
  hook    [label="scope-guard\nClaude Code hook / OpenCode plugin\nwarn (default) or block", fillcolor="#eafff0", color="#1faa59"];
  target  [label="target\n(authorized web app / API)", fillcolor="#fff0f0", color="#e03131"];
  out     [label="engagements/<dir>\nrecon · scan · findings · report.md", fillcolor="#f3f1ff", color="#6d5efc"];

  user -> cc;
  gen -> cc [label="generates host files", style=dashed];
  know -> cc [label="informs", style=dashed];
  cc -> planner [label="delegates", style=dashed];
  cc -> setup; cc -> recon; cc -> scan; cc -> exploit; cc -> report;
  cc -> browser [style=dashed];
  recon -> shim; scan -> shim; exploit -> shim;
  browser -> target [label="renders DOM", style=dashed];
  shim -> toolbox [label="docker exec"];
  shim -> hook [label="checked by", style=dashed];
  toolbox -> target [label="scope-gated tools"];
  cc -> out;
  report -> out;
}
