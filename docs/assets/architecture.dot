// Mythos architecture. Render: dot -Tsvg architecture.dot -o architecture.svg
//                               dot -Tpng -Gdpi=160 architecture.dot -o architecture.png
digraph mythos {
  rankdir=LR;
  bgcolor="transparent";
  compound=true;
  ranksep=0.5;
  nodesep=0.28;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#6d5efc", fillcolor="#f3f1ff", fontcolor="#1f2430"];
  edge [color="#6d7086", fontname="Helvetica", fontsize=9, fontcolor="#6d7086"];

  operator [label="operator\nmythos -t <url> --scope scope.yaml\nscope.yaml = the authorization boundary,\nthe only human gate", fillcolor="#e0f7fb", color="#22d3ee"];

  driver [label="driver (cli/src/driver.ts)\nphase order · artifact gate · retries\nbudget = share of the time LEFT:\nrecon .3 · scan .35 · exploit .7 · report 1.0,\nfloor 300s", fillcolor="#efeaff", color="#6d5efc"];

  subgraph cluster_phases {
    label="one agent per phase · fresh context · handoff only through files";
    style="rounded,dashed"; color="#8b93a7"; fontname="Helvetica"; fontsize=10;
    recon   [label="recon\nprobe · cvefeed match\nfingerprint, identities\ngate: surface.json\n+ recon.md"];
    scan    [label="scan\nverify · nuclei · dalfox\nsqlmap · arjun\ngate: candidates.md"];
    exploit [label="exploit\n--workers agents in parallel,\nround-robin over endpoints\nwithout a verdict, max 6 rounds\ngate: a verdict per endpoint"];
    report  [label="report\nCVSS from the vector\ncoverage check\ngate: report.md\n+ findings.json"];
  }

  ledger    [label="verdict ledger (verdicts.ts)\nconfirmed · tested · skipped\nverdicts.json", fillcolor="#fff7e6", color="#e0a800"];
  validator [label="validator pass\nvalidator tier, a different model,\nno tools → validation.md", fillcolor="#fff7e6", color="#e0a800"];

  tools [label="tool layer (cli/src/agent/)\nshell · request · script\nfiles · reference · browser", fillcolor="#eef2ff", color="#3b5bdb"];
  guards [label="guards.ts → hooks/*.py --check\nCALLED FROM INSIDE EVERY\nTARGET-REACHING TOOL\nscope: warn · rate: warn + sleep\ndestruction · brute force · DoS: refused",
          fillcolor="#eafff0", color="#1faa59", penwidth=2];

  toolbox [label="mythos-toolbox (Kali, Docker)\nvia scripts/mythos docker exec\nnuclei · sqlmap · dalfox · ffuf · katana\nhttpx · nikto · arjun · jwt_tool · curl\n/repo read-only, engagements/ writable\nMYTHOS_NET=host for a loopback target",
           fillcolor="#eef2ff", color="#3b5bdb"];
  chromium [label="Chromium (playwright-core)\non the host, outside the container\nDOM · console · network log", fillcolor="#eef2ff", color="#3b5bdb"];
  hostscripts [label="scripts/probe · scripts/verify\non the host, vetted the same way", fillcolor="#eef2ff", color="#3b5bdb"];

  skills [label="skills/ · knowledge/\nthe methodology,\nread at runtime", fillcolor="#eafff0", color="#1faa59"];
  models [label="models.json\ntier per agent,\nmodel per profile", fillcolor="#eafff0", color="#1faa59"];
  bus    [label="event bus (bus.ts)\nInk view or -n logger\nrun-events.jsonl\np pause · h hint · q abort", fillcolor="#f3f1ff", color="#6d5efc"];

  dir [label="engagements/<dir>/\nsurface.json · cve-candidates.json\nrecon.md · candidates.md\nverdicts/ · verdicts.json\nfindings/ · validation.md\nreport.md · findings.json/.sarif\ntraffic/ · run-events.jsonl",
       shape=note, style="filled", fillcolor="#f3f1ff", color="#6d5efc"];

  target [label="target\n(authorized web app / API)", fillcolor="#fff0f0", color="#e03131"];

  operator -> driver [label="pins MYTHOS_SCOPE"];
  driver -> recon;
  recon -> scan [label="artifact gate"];
  scan -> exploit [label="artifact gate"];
  exploit -> report [label="artifact gate"];
  exploit -> validator [label="findings/*.md"];
  validator -> report [label="validation.md", constraint=false];
  models -> driver [label="tier per phase", style=dashed];

  recon -> tools [constraint=false]; scan -> tools [constraint=false];
  exploit -> tools [constraint=false]; report -> tools [constraint=false];
  skills -> tools [label="reference tool", style=dashed];
  exploit -> ledger [label="verdicts/<slug>.md", constraint=false];
  ledger -> exploit [label="endpoints still open", style=dashed, constraint=false];

  tools -> guards [label="vet, every call", penwidth=2];
  guards -> toolbox [label="allowed"];
  guards -> chromium [label="allowed (goto)"];
  guards -> hostscripts [label="allowed"];
  hostscripts -> target [label="GET only, paced"];
  toolbox -> target [label="recorded by scripts/traffic, paced"];
  chromium -> target [label="renders the DOM", style=dashed];

  tools -> dir [label="files tool"];
  ledger -> dir [style=dashed, constraint=false];
  driver -> bus [label="every event", style=dashed, constraint=false];
  bus -> driver [label="hint · pause · abort", style=dashed, constraint=false];
  bus -> dir [style=dashed, constraint=false];

  { rank=same; driver; tools; }
  { rank=same; bus; models; }
}
