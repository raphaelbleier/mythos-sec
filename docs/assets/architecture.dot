// Mythos architecture — render: dot -Tsvg architecture.dot -o architecture.svg
digraph mythos {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#6d5efc", fillcolor="#f3f1ff", fontcolor="#1f2430"];
  edge [color="#6d7086", fontname="Helvetica", fontsize=9, fontcolor="#6d7086"];

  user [label="operator\n/cybersecurity <target>\nor  mythos-agent <target>", fillcolor="#e0f7fb", color="#22d3ee"];

  subgraph cluster_llm {
    label="LLM backends (pluggable)"; style="rounded,dashed"; color="#8b93a7"; fontname="Helvetica";
    cli   [label="claude CLI\n(no API key)"];
    lite  [label="LiteLLM\n(any provider / local Ollama)"];
    api   [label="Anthropic API\n(ANTHROPIC_API_KEY)"];
  }

  agent [label="Agent runtime\nReAct loop\n(reason → act → observe)", fillcolor="#efeaff", color="#6d5efc"];
  orch  [label="Multi-agent orchestrator\nparallel sub-agents\n(recon · scan · validate)", fillcolor="#efeaff", color="#6d5efc"];
  state [label="shared state\ncoverage matrix · task tree · notes", fillcolor="#fff7e6", color="#e0a800"];

  subgraph cluster_tools {
    label="tool registry"; style="rounded,dashed"; color="#8b93a7"; fontname="Helvetica";
    recon [label="recon\nfingerprint · crawl (SPA/JS)\nOpenAPI import · discover"];
    checks [label="checks\nSQLi/XSS/SSTI/SSRF/CRLF\npath · IDOR/BOLA · JWT · CORS"];
    browser [label="browser\nheadless Chromium\nDOM-XSS"];
    intel [label="CVE intel\nNVD lookup"];
  }

  engine [label="scope-aware engine\nHttpClient: scope gate · rate limit\nbudget · evidence", fillcolor="#eafff0", color="#1faa59"];
  toolbox [label="Kali toolbox (Docker)\nnuclei · sqlmap · dalfox · ffuf\nkatana · subfinder · jwt_tool", fillcolor="#eef2ff", color="#3b5bdb"];
  proxy [label="upstream proxy\nBurp / Caido / ZAP\n(optional)", fillcolor="#f6f6f6", color="#8b93a7"];
  target [label="target\n(authorized web app / API)", fillcolor="#fff0f0", color="#e03131"];
  report [label="findings → report.md\n(bounty format) + agent.json", fillcolor="#f3f1ff", color="#6d5efc"];

  user -> agent;
  cli -> agent; lite -> agent; api -> agent;
  agent -> orch [label="spawns"];
  agent -> state [dir=both];
  orch -> state [dir=both];
  agent -> recon; agent -> checks; agent -> browser; agent -> intel;
  recon -> engine; checks -> engine; browser -> engine;
  checks -> toolbox [label="docker exec\nproxy", style=dashed];
  engine -> proxy [style=dashed];
  engine -> target [label="scope-gated HTTP"];
  toolbox -> target [label="scope-gated"];
  proxy -> target;
  agent -> report;
}
