#!/usr/bin/env python3
"""Mythos aiplatform — the AI stack as a web target, measured not asserted.

Three things the research says about AI targets, and this file does one each:

1. The money is classic bugs in new software. Real exploited AI-app bugs were
   unauthenticated file reads, path traversals and code injection in builders
   and model servers, not model behaviour. `fingerprint` reads the version off
   the surfaces that answer unauthenticated, read-only GETs, and stops at the
   version. It never runs a model: a `POST /api/generate` spends the target's
   money and proves nothing a `GET /api/tags` does not.
2. A fixed payload set proves nothing. "The Attacker Moves Second" (Nasr,
   Carlini, Sitawarin, Schulhoff et al., 2025-10-10) broke 12 published
   defences at over 90% attack success where their own authors had reported
   near zero. So `inject` mutates over carrier, framing and encoding, keeps a
   negative control per variant, and reports a confidence interval.
3. Ten trials do not pin a rate down. At k=10, 5 successes is a 95% interval of
   roughly 24% to 76%, and a control of 0 of 10 only bounds the control rate
   below about 31%. `inject` prints the interval so that nobody reads "5/10" as
   "about half".

  scripts/aiplatform fingerprint <url> ...  version reads for n8n, Ollama, vLLM
                                             and OpenAI-compatible servers,
                                             vector DBs, gateways, Gradio,
                                             Streamlit, Jupyter, Dify, Open
                                             WebUI, LiteLLM, ComfyUI, Langflow,
                                             Flowise, Triton
  scripts/aiplatform mcp <url> ...          tools/list snapshot and diff (rug
                                             pull), descriptor scan (tool
                                             poisoning), session-id entropy and
                                             cross-user replay
  scripts/aiplatform inject <url> ...       mutating injection runner: per-trial
                                             nonce, OAST oracle, per-variant
                                             control, k trials, Wilson and
                                             Clopper-Pearson intervals, spend cap
  scripts/aiplatform wallet <url> ...       denial of wallet as a CAPABILITY
                                             check: does a cap exist at all
  scripts/aiplatform --selftest

NO FLOOD, EVER. `wallet` answers "is there a per-user or per-key cap" from under
ten requests on an account you own. AGENTS.md refuses denial of service in every
mode and no scope rule overrides that, so there is no flood mode in this file to
turn on. Every trial in `inject` spends the target's tokens, which is why there
is a hard request cap and why it is on by default.

CVE work belongs to `skills/cve-deep-dive`. This file reports the version
against the advisory range and stops: no exploit attempt, no PoC.
"""
import argparse
import base64
import hashlib
import importlib.machinery
import importlib.util
import json
import math
import os
import pathlib
import random
import re
import ssl
import string
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

UA = "mythos-aiplatform/1.0 (authorized security testing)"
ROOT = pathlib.Path(__file__).resolve().parent.parent

# ---------------------------------------------------------------- plumbing

_mods = {}


def mod(name):
    if name not in _mods:
        rel = {"scope-guard": "hooks/scope-guard.py"}[name]
        loader = importlib.machinery.SourceFileLoader(
            f"mythos_{name}".replace("-", "_"), str(ROOT / rel))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        m = importlib.util.module_from_spec(spec)
        loader.exec_module(m)
        _mods[name] = m
    return _mods[name]


def require_in_scope(*items):
    sg = mod("scope-guard")
    bad = []
    for item in items:
        if not item:
            continue
        probe = item if "//" in str(item) else f"https://{item}/"
        bad += sg.check(probe)["offenders"]
    if bad:
        raise SystemExit("aiplatform: refusing, out of scope: " + ", ".join(sorted(set(bad))))


def scope_rate(default=5.0):
    path = os.environ.get("MYTHOS_SCOPE")
    if not path:
        return default
    try:
        text = pathlib.Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return default
    try:
        import yaml  # type: ignore
        rules = (yaml.safe_load(text) or {}).get("rules") or {}
        if isinstance(rules, dict) and rules.get("rate_limit_rps") is not None:
            return float(rules["rate_limit_rps"])
    except Exception:
        pass
    m = re.search(r"^\s*rate_limit_rps\s*:\s*([0-9.]+)", text, re.M)
    try:
        return float(m.group(1)) if m else default
    except (TypeError, ValueError):
        return default


_LAST, _GAP, _SENT, _CAP = [0.0], [0.0], [0], [None]


def pace():
    if _GAP[0] <= 0:
        return
    wait = _LAST[0] + _GAP[0] - time.monotonic()
    if wait > 0:
        time.sleep(wait)
    _LAST[0] = time.monotonic()


class SpendCap(Exception):
    """The request budget ran out. Every trial costs the target money."""


def send(method, url, headers=None, body=None, timeout=15, insecure=False):
    require_in_scope(url)
    if _CAP[0] is not None and _SENT[0] >= _CAP[0]:
        raise SpendCap(f"request cap {_CAP[0]} reached")
    pace()
    _SENT[0] += 1
    data = body.encode() if isinstance(body, str) else body
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"User-Agent": UA, **(headers or {})})
    ctx = ssl._create_unverified_context() if insecure else None
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            raw = r.read(400_000)
            return {"status": r.status, "headers": {k.lower(): v for k, v in r.headers.items()},
                    "body": raw.decode("utf-8", "replace"), "url": r.geturl()}
    except urllib.error.HTTPError as e:
        raw = e.read(200_000) if e.fp else b""
        return {"status": e.code,
                "headers": {k.lower(): v for k, v in (e.headers or {}).items()},
                "body": raw.decode("utf-8", "replace"), "url": url}
    except Exception as e:
        return {"status": None, "headers": {}, "body": f"{type(e).__name__}: {e}", "url": url}


def extra_headers(items):
    """'Name: value' pairs, with a readable error instead of a ValueError."""
    out = {}
    for h in items or []:
        name, sep, value = h.partition(":")
        if not sep or not name.strip():
            raise SystemExit(f"aiplatform: bad --header {h!r}: expected 'Name: value'")
        out[name.strip()] = value.strip()
    return out


def nonce(n=10):
    alpha = string.ascii_lowercase + string.digits
    return "n" + "".join(random.choice(alpha) for _ in range(n))

# =================================================== 1. fingerprint

# Each probe is one unauthenticated, read-only GET. `version` is a dotted path
# into the JSON answer, or a regex over the body. Nothing here POSTs, and
# nothing here asks a model for a completion: an inference call costs the
# target money and tells you nothing the version does not.
