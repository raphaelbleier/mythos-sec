#!/usr/bin/env python3
"""Which parts of the mapped surface the engagement has not accounted for yet.

  scripts/probe <target> --json > engagements/<dir>/surface.json
  scripts/coverage engagements/<dir>              # OPEN lines, exit 1 while any remain
  scripts/coverage engagements/<dir> --list 15    # cap the listing
  scripts/coverage engagements/<dir> --text FILE  # also count this text as the report

An item counts as covered when its path appears in `report.md`, under `findings/`, or in the
text passed with `--text` (the gate passes the agent's own transcript, since an engagement
may report in the conversation and never write a file),
whether as a finding or as an explicit "tested, not vulnerable". That is a text check,
not proof: it stops the engagement from silently skipping a whole surface, which is the
failure this exists for (on Vuln Bank both benchmark arms never sent one request to the
GraphQL, merchant, bill-payment and card endpoints). It cannot tell a real test from a
mention, so it is a floor on coverage, never evidence of it.
"""
import json
import re
import sys
from pathlib import Path

HTTP_METHODS = ("GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS")


def surface(d):
    """Paths and parameters worth accounting for, from the probe's JSON map."""
    f = Path(d) / "surface.json"
    if not f.exists():
        return []
    m = json.loads(f.read_text())
    origin = m.get("origin") or m.get("target") or ""
    items = []
    for page in m.get("pages", []):
        url = page.get("url") or page.get("path") or ""
        items.append(url[len(origin):] if origin and url.startswith(origin) else url)
        for form in page.get("forms", []):
            items.append(form.get("action") or "")
    items += [r["path"] if isinstance(r, dict) else str(r) for r in m.get("reachable_paths", [])]
    # OpenAPI entries read "POST /register"; GraphQL entries read "mutation importPaste(a, b)"
    # and must stay whole, since splitting on spaces would leave a fragment of the argument list.
    items += [str(e).split()[-1] if str(e).split()[0] in HTTP_METHODS else str(e)
              for e in m.get("api_endpoints", []) if str(e).strip()]
    # A GraphQL-only app maps to a handful of pages, so its parameters are the real surface.
    items += [f"param:{p['name']}" for p in m.get("parameters", []) if p.get("name")]
    out = []
    for i in items:                      # keep order, drop duplicates and bare roots
        i = i.strip()
        if i and i != "/" and i not in out:
            out.append(i)
    return out


def covered(d, extra=None):
    d = Path(d)
    text = Path(extra).read_text(errors="replace") if extra and Path(extra).exists() else ""
    r = d / "report.md"
    if r.exists():
        text += r.read_text(errors="replace")
    for f in sorted((d / "findings").glob("*")) if (d / "findings").is_dir() else []:
        if f.is_file():
            text += f.read_text(errors="replace")
    return text


def match_key(item):
    """What to look for in the report. An item is printed as mapped, e.g. `param:redirect_to` or
    `mutation importPaste(host, path, port, scheme)`; the report will name `redirect_to` and
    `importPaste`, never the decorated form."""
    if item.startswith("param:"):
        return item[len("param:"):]
    for prefix in ("query ", "mutation ", "POST ", "GET ", "PUT ", "PATCH ", "DELETE "):
        if item.startswith(prefix):
            item = item[len(prefix):]
            break
    return item.split("(")[0].strip()


def is_covered(item, text):
    """Whether the report names this item as its own token, not as a fragment of another.

    Plain substring search let "identified" cover `param:id` and a report on `/api/v1/charge`
    cover `/api`, which inflated every coverage number. A path must be a whole path: not the
    tail of a longer path (`/v2/api`) and not the head of one (`/api/v1`). A bare name (a
    parameter or GraphQL field) must sit on word boundaries and is case-sensitive, since
    `Id` and `id` are different parameters. A scheme and host are stripped from the report
    first so that `https://host/api` still counts as `/api`."""
    key = match_key(item)
    if not key:
        return False
    if key.startswith("/"):
        text = re.sub(r"https?://[^/\s]+", "", text)
        pat = r"(?<![\w/.-])" + re.escape(key.rstrip("/")) + r"(?![\w-]|[/.]\w)"
    else:
        pat = r"(?<!\w)" + re.escape(key) + r"(?!\w)"
    return re.search(pat, text) is not None


def open_items(d, extra=None):
    text = covered(d, extra)
    return [i for i in surface(d) if not is_covered(i, text)]


def _selftest():
    text = "We reviewed the /api/v1/charge endpoint thoroughly and identified nothing"
    assert is_covered("/api/v1/charge", text)
    assert not is_covered("/api", text), "head of a longer path"
    assert not is_covered("/admin", text)
    assert not is_covered("param:r", text), "substring of a word"
    assert not is_covered("param:id", text), "inside 'identified'"
    assert not is_covered("param:to", text)
    assert is_covered("param:id", "tested id for IDOR, not vulnerable")
    assert not is_covered("param:id", "tested Id only"), "params are case-sensitive"
    assert is_covered("/api", "GET /api returned 200") and is_covered("/api", "see `/api`.")
    assert is_covered("/api", "https://host.example/api was tested")
    assert not is_covered("/api", "the /v2/api route") and not is_covered("/api", "/apiary")
    assert is_covered("mutation importPaste(a, b)", "importPaste is injectable")
    assert not is_covered("mutation importPaste(a, b)", "reimportPasted")
    print("selftest ok")


def main():
    if "--selftest" in sys.argv:
        return _selftest()
    if len(sys.argv) < 2:
        raise SystemExit(__doc__)
    d = sys.argv[1]
    cap = int(sys.argv[sys.argv.index("--list") + 1]) if "--list" in sys.argv else 40
    extra = sys.argv[sys.argv.index("--text") + 1] if "--text" in sys.argv else None
    items, total = open_items(d, extra), len(surface(d))
    if not total:
        print(f"no surface map: run scripts/probe <target> --json > {d}/surface.json")
        return 0
    for i in items[:cap]:
        print(f"OPEN {i}")
    if len(items) > cap:
        print(f"... and {len(items) - cap} more")
    print(f"{total - len(items)}/{total} mapped paths accounted for in the report")
    return 1 if items else 0


if __name__ == "__main__":
    sys.exit(main())
