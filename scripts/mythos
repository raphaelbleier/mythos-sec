#!/usr/bin/env python3
"""Mythos toolbox driver: a thin stdlib-only shim over the Kali toolbox container.

Mythos is skill-driven: Claude Code is the agent and runs REAL security tools
inside the container via the subcommands below. No engine, no second LLM.

  scripts/mythos up                  pull (or build) the image + start the toolbox
  scripts/mythos tools               show key tools and versions
  scripts/mythos run nuclei -u URL   run one tool (argv passed as a list, no shell)
  scripts/mythos sh 'ffuf ... | jq'  run a shell pipeline in the toolbox
  scripts/mythos <tool> [args...]    shorthand for `run <tool> ...`
  scripts/mythos net <network>       connect the toolbox to a lab docker network
  scripts/mythos down                stop + remove the toolbox

Env: MYTHOS_IMAGE (default ghcr.io/raphaelbleier/mythos-toolbox:latest),
     MYTHOS_BUILD=1 (force local build), MYTHOS_CONTAINER (default mythos-toolbox).
Every exec is logged (before and after) to engagements/audit.jsonl.
The repo is mounted at /repo; host.docker.internal reaches the host.
"""
import json, os, subprocess, sys, time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
IMG = os.environ.get("MYTHOS_IMAGE", "ghcr.io/raphaelbleier/mythos-toolbox:latest")
LOCAL = "mythos-toolbox"
NAME = os.environ.get("MYTHOS_CONTAINER", "mythos-toolbox")
AUDIT = REPO / "engagements" / "audit.jsonl"
ENV = {**os.environ, "MSYS_NO_PATHCONV": "1"}  # Git Bash must not rewrite /repo

TOOLS = ("nuclei sqlmap dalfox ffuf katana subfinder httpx nikto whatweb arjun "
         "wafw00f interactsh-client commix gf qsreplace jwt_tool").split()
TOOLS_SH = ('for t in %s; do printf "%%-18s " "$t"; if command -v "$t" >/dev/null 2>&1; then '
            '("$t" -version || "$t" --version || echo OK) 2>&1 | head -1; '
            'else echo MISSING; fi; done' % " ".join(TOOLS))


def docker(*a, check=False, quiet=True):
    r = subprocess.run(["docker", *a], env=ENV, capture_output=quiet, text=True)
    if check and r.returncode:
        sys.exit(r.stderr or r.returncode)
    return r


def audit(**kw):
    AUDIT.parent.mkdir(exist_ok=True)
    with AUDIT.open("a") as f:
        f.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), **kw}) + "\n")


def running():
    return NAME in docker("ps", "--format", "{{.Names}}").stdout.split()


def have(img):
    return docker("image", "inspect", img).returncode == 0


def image():
    """Pick the image to run: pulled GHCR image, else local build."""
    global IMG
    if os.environ.get("MYTHOS_BUILD") != "1":
        if have(IMG) or docker("pull", IMG, quiet=False).returncode == 0:
            return IMG
        print(f"mythos: pull of {IMG} failed, building locally.", file=sys.stderr)
    if os.environ.get("MYTHOS_BUILD") == "1" or not have(LOCAL):
        print("mythos: building toolbox image (a few minutes)...", file=sys.stderr)
        docker("build", "-t", LOCAL, "-f", str(REPO / "toolbox" / "Dockerfile"), str(REPO),
               check=True, quiet=False)
    return LOCAL


def up():
    if running():
        return
    img = image()
    docker("rm", "-f", NAME)
    args = ["run", "-d", "--rm", "--init", "--name", NAME,
            "--cap-drop", "ALL", "--cap-add", "NET_RAW",
            "--security-opt", "no-new-privileges",
            "--add-host=host.docker.internal:host-gateway",
            "-v", f"{REPO}:/repo", "-w", "/repo"]
    if sys.platform.startswith("linux"):  # keep bind-mount files owned by the host user
        args += ["--user", f"{os.getuid()}:{os.getgid()}"]
    docker(*args, img, check=True)
    print(f"mythos: toolbox '{NAME}' up (repo mounted at /repo).", file=sys.stderr)


def exec_(argv):
    if not running():
        up()
    t = time.time()
    audit(phase="start", argv=argv)
    tty = ["-t"] if sys.stdin.isatty() and sys.stdout.isatty() else []
    rc = subprocess.run(["docker", "exec", "-i", *tty, "-w", "/repo", NAME, *argv], env=ENV).returncode
    audit(phase="end", argv=argv, exit=rc, seconds=round(time.time() - t, 2))
    return rc


def main(a):
    if not a:
        sys.exit("usage: scripts/mythos {up|down|tools|net <network>|sh <cmd>|run <tool ...>|<tool ...>}")
    if docker("info").returncode:
        sys.exit("mythos: cannot reach the Docker daemon (is it running, and is your user in the docker group?)")
    c, rest = a[0], a[1:]
    if c == "up": up()
    elif c == "down":
        docker("rm", "-f", NAME); print("mythos: toolbox down.", file=sys.stderr)
    elif c == "build":
        os.environ["MYTHOS_BUILD"] = "1"; image()
    elif c == "tools": return exec_(["bash", "-lc", TOOLS_SH])
    elif c == "net":
        if not rest: sys.exit("usage: scripts/mythos net <docker-network>")
        if not running(): up()
        r = docker("network", "connect", rest[0], NAME)
        if r.returncode and "already exists" not in r.stderr: sys.exit(r.stderr)
        print(f"mythos: toolbox connected to {rest[0]}.", file=sys.stderr)
    elif c == "sh": return exec_(["bash", "-lc", " ".join(rest)])
    elif c == "run": return exec_(rest)
    else: return exec_(a)  # shorthand: scripts/mythos nuclei -u ...
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
