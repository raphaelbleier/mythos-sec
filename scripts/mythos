#!/usr/bin/env python3
"""Mythos toolbox driver: a thin stdlib-only shim over the Kali toolbox container.

The agent (`cli/`, the `shell` tool) runs REAL security tools inside the
container via the subcommands below. Nothing runs on the operator's machine.

  scripts/mythos up                  pull (or build) the image, verify its cosign signature, start the toolbox
  scripts/mythos tools               show key tools and versions
  scripts/mythos run nuclei -u URL   run one tool (argv passed as a list, no shell)
  scripts/mythos sh 'ffuf ... | jq'  run a shell pipeline in the toolbox (several args = one quoted command)
  scripts/mythos <tool> [args...]    shorthand for `run <tool> ...`
  scripts/mythos net <network>       connect the toolbox to a lab docker network
  scripts/mythos down                stop + remove the toolbox
  scripts/mythos --timeout N <cmd>   kill this one exec after N seconds (0 = no limit)

Env: MYTHOS_NET (host = share the host's network namespace, needed for a target bound
     to 127.0.0.1; a docker network name = also attach the bridged toolbox to it),
     MYTHOS_IMAGE (default: the digest in toolbox/IMAGE_DIGEST, updated per release),
     MYTHOS_BUILD=1 (force local build), MYTHOS_CONTAINER (default mythos-toolbox),
     MYTHOS_TIMEOUT (default 900 s per exec; a hung sqlmap or ffuf must not eat an
     unattended engagement's budget. Exit 124/137 = hit the limit).
Every exec is logged (before and after) to engagements/audit.jsonl.
The repo is mounted read-only at /repo, only engagements/ is writable (and audit.jsonl in
it is read-only): the host executes hooks/, scripts/ and skills/, so the container must not
be able to rewrite them. host.docker.internal reaches the host.
"""
import json, os, shlex, shutil, subprocess, sys, time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
OFFICIAL = "ghcr.io/raphaelbleier/mythos-toolbox"
# Digest of the signed release image; a release updates this file, never a mutable tag.
IMG = os.environ.get("MYTHOS_IMAGE") or f"{OFFICIAL}@{(REPO / 'toolbox' / 'IMAGE_DIGEST').read_text().strip()}"
SIGNER = r"^https://github\.com/raphaelbleier/mythos-sec/\.github/workflows/toolbox\.yml@refs/(tags/v[^/]+|heads/main)$"
ISSUER = "https://token.actions.githubusercontent.com"
TIMEOUT = int(os.environ.get("MYTHOS_TIMEOUT", "900"))
LOCAL = "mythos-toolbox"
NAME = os.environ.get("MYTHOS_CONTAINER", "mythos-toolbox")
AUDIT = REPO / "engagements" / "audit.jsonl"
ENV = {**os.environ, "MSYS_NO_PATHCONV": "1"}  # Git Bash must not rewrite /repo

TOOLS = ("nuclei sqlmap dalfox ffuf katana subfinder httpx nikto whatweb arjun "
         "wafw00f interactsh-client commix gf qsreplace jwt_tool "
         "smuggler.py wcvs graphw00f graphql-cop grpcurl ysoserial phpggc").split()
TOOLS_SH = ('for t in %s; do printf "%%-18s " "$t"; if command -v "$t" >/dev/null 2>&1; then '
            '("$t" -version || "$t" --version || echo OK) 2>&1 | head -1; '
            'else echo MISSING; fi; done' % " ".join(TOOLS))


def docker(*a, check=False, quiet=True):
    r = subprocess.run(["docker", *a], env=ENV, capture_output=quiet, text=True)
    if check and r.returncode:
        sys.exit(r.stderr or r.returncode)
    return r


def audit(**kw):
    AUDIT.parent.mkdir(exist_ok=True)
    with AUDIT.open("a") as f:
        f.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "t": round(time.time(), 3), **kw}) + "\n")


def capture_env():
    """-e arguments for the proxy and CA variables when this engagement records its traffic
    (scripts/traffic). Nothing when it does not. When it does and the proxy is down this exits:
    an unrecorded request would make the record lie by omission."""
    if not os.environ.get("MYTHOS_SCOPE"):
        return []
    r = subprocess.run([sys.executable, str(REPO / "scripts" / "traffic"), "env", "--container", "--json"],
                       capture_output=True, text=True)
    if r.returncode:
        sys.exit(r.stderr.strip())
    return [x for k, v in json.loads(r.stdout or "{}").items() for x in ("-e", f"{k}={v}")]


def running():
    return NAME in docker("ps", "--format", "{{.Names}}").stdout.split()


def have(img):
    return docker("image", "inspect", img).returncode == 0


def image():
    """Pick the image to run: pulled GHCR image, else local build."""
    global IMG
    if os.environ.get("MYTHOS_BUILD") != "1":
        # An image the operator pinned by hand is the one they want, so a local
        # copy is used as it is. Pulling it first printed "pull access denied"
        # for every local tag before falling back to the same image anyway, which
        # reads like a failure in the middle of a working start.
        if os.environ.get("MYTHOS_IMAGE") and have(IMG):
            return IMG
        # A digest is content-addressed, so a local copy needs no refresh; a tag does.
        if ("@sha256:" in IMG and have(IMG)) or docker("pull", IMG, quiet=False).returncode == 0 or have(IMG):
            return IMG
        print(f"mythos: pull of {IMG} failed, building locally.", file=sys.stderr)
    if os.environ.get("MYTHOS_BUILD") == "1" or not have(LOCAL):
        print("mythos: building toolbox image (a few minutes)...", file=sys.stderr)
        docker("build", "-t", LOCAL, "-f", str(REPO / "toolbox" / "Dockerfile"), str(REPO),
               check=True, quiet=False)
    return LOCAL


def verify(img):
    """Check the cosign signature of the official image; a bad or missing one is fatal."""
    if img == LOCAL:
        return
    cmd = ["cosign", "verify", "--certificate-identity-regexp", SIGNER,
           "--certificate-oidc-issuer", ISSUER, img]
    if not img.startswith(OFFICIAL):
        print(f"mythos: {img} is not the official image, signature not checked.", file=sys.stderr)
    elif not shutil.which("cosign"):
        print(f"mythos: cosign not found, image signature NOT verified. Run: {shlex.join(cmd)}", file=sys.stderr)
    else:
        r = subprocess.run(cmd, env=ENV, capture_output=True, text=True)
        if r.returncode:
            sys.exit(f"mythos: cosign verification of {img} FAILED, refusing to start it.\n{r.stderr}")


def up():
    if running():
        return
    if docker("info").returncode:
        sys.exit("mythos: cannot reach the Docker daemon (is it running, and is your user in the docker group?)")
    img = image()
    verify(img)
    docker("rm", "-f", NAME)
    AUDIT.parent.mkdir(exist_ok=True)
    AUDIT.touch()
    args = ["run", "-d", "--rm", "--init", "--name", NAME,
            "--cap-drop", "ALL", "--cap-add", "NET_RAW",
            "--security-opt", "no-new-privileges"]
    # A target bound to the host's loopback is not reachable from a bridged
    # container at all: host-gateway reaches the host's external address, and a
    # service listening only on 127.0.0.1 does not answer there. Every lab app in
    # lab/docker-compose.yml binds that way on purpose, so a bridged toolbox can
    # never test one, which is how a benchmark arm spent its budget hunting for an
    # address that does not exist. MYTHOS_NET=host puts the toolbox in the host's
    # network namespace, where 127.0.0.1 is the same loopback.
    #
    # It also removes the isolation between container and host, so it is for a
    # local lab target and nothing else. The CLI sets it only for a loopback
    # target; for a routable target the bridge is correct and stays.
    net = os.environ.get("MYTHOS_NET")
    if net == "host":
        args += ["--network", "host"]
    else:
        args += ["--add-host=host.docker.internal:host-gateway"]
        if net:
            args += ["--network", net]
    args += ["-v", f"{REPO}:/repo:ro", "-v", f"{AUDIT.parent}:/repo/engagements",
             "-v", f"{AUDIT}:/repo/engagements/audit.jsonl:ro", "-w", "/repo"]
    if sys.platform.startswith("linux"):  # keep bind-mount files owned by the host user
        args += ["--user", f"{os.getuid()}:{os.getgid()}"]
    docker(*args, img, check=True)
    print(f"mythos: toolbox '{NAME}' up (repo mounted at /repo).", file=sys.stderr)


def exec_(argv):
    if not running():
        up()
    env = capture_env()
    t = time.time()
    audit(phase="start", argv=argv, timeout=TIMEOUT)
    tty = ["-t"] if sys.stdin.isatty() and sys.stdout.isatty() else []
    limit = ["timeout", "--signal=TERM", "--kill-after=5", str(TIMEOUT)] if TIMEOUT > 0 else []
    rc = subprocess.run(["docker", "exec", "-i", *tty, *env, "-w", "/repo", NAME, *limit, *argv], env=ENV).returncode
    audit(phase="end", argv=argv, exit=rc, seconds=round(time.time() - t, 2))
    if limit and rc in (124, 137):
        print(f"mythos: exit {rc}, probably the {TIMEOUT}s limit; rerun with --timeout N (0 = none).", file=sys.stderr)
    return rc


def main(a):
    global TIMEOUT
    if a[:1] == ["--timeout"]:
        if len(a) < 2 or not a[1].isdigit():
            sys.exit("usage: scripts/mythos --timeout SECONDS <command ...>")
        TIMEOUT, a = int(a[1]), a[2:]
    if not a:
        sys.exit("usage: scripts/mythos [--timeout N] {up|down|tools|net <network>|sh <cmd>|run <tool ...>|<tool ...>}")
    c, rest = a[0], a[1:]
    if c == "up": up()
    elif c == "down":
        docker("rm", "-f", NAME); print("mythos: toolbox down.", file=sys.stderr)
    elif c == "build":
        os.environ["MYTHOS_BUILD"] = "1"; image()
    elif c == "tools": return exec_(["bash", "-lc", TOOLS_SH])
    elif c == "net":
        if not rest: sys.exit("usage: scripts/mythos net <docker-network>")
        if not running(): up()
        r = docker("network", "connect", rest[0], NAME)
        if r.returncode and "already exists" not in r.stderr: sys.exit(r.stderr)
        print(f"mythos: toolbox connected to {rest[0]}.", file=sys.stderr)
    elif c == "sh": return exec_(["bash", "-lc", rest[0] if len(rest) == 1 else shlex.join(rest)])
    elif c == "run": return exec_(rest)
    else: return exec_(a)  # shorthand: scripts/mythos nuclei -u ...
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
