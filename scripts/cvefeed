#!/usr/bin/env python3
"""Mythos CVE feed — fresh CVE intelligence for the fingerprinted stack, in one call.

The triage pipeline is in `knowledge/techniques/cve-triage-2026.md`: KEV first,
then EPSS, then whether the version on the target is actually in the affected
range, then whether a proof of concept or a nuclei template exists. This
implements that pipeline over live data, so the engagement is never reasoning
from CVE ids someone hard-coded months ago.

  scripts/cvefeed status                       # how old is the data, and where from
  scripts/cvefeed refresh                      # refresh the local cache from the feeds
  scripts/cvefeed refresh --out knowledge/cve  # write the committed snapshot (CI)
  scripts/cvefeed products                     # what it fingerprints, and where the version leaks
  scripts/cvefeed match --fingerprint langflow@1.6.0 --product nginx
  scripts/probe <url> --depth 2 --json | scripts/cvefeed match --from-probe --json

`match` prints a **ranked list of what is worth testing**, never a verdict: a
KEV entry means exploited in the wild somewhere, not that this target is
vulnerable. Every row carries the feed it came from, when that feed was
fetched, and how confident the version match is.

Data path: the local cache (TTL `--ttl-hours`, default 6) → a live refresh →
the committed snapshot `knowledge/cve/snapshot.json`, whose age is always
printed. A failed fetch, a rate limit or a malformed answer degrades to the
snapshot; it never raises.

Hosts it contacts (third-party APIs, *not* the target — the engagement's scope
covers the target, these are out of it by definition, so a scope-guard warning
naming one of them is this tool doing its job):

  www.cisa.gov            CISA KEV catalog (JSON feed)
  api.first.org           EPSS scores (batched, 100 CVEs per request)
  services.nvd.nist.gov   NVD 2.0 recent-window query (NVD_API_KEY honored)
  raw.githubusercontent.com   nuclei-templates cves.json (CVE -> template path)
  api.github.com          GHSA advisories (needs a token: CI only, see below)
  api.osv.dev             OSV package queries, incl. MAL-* malicious packages

GHSA needs a token, and an engagement must not require a new secret, so GHSA is
fetched only where `GITHUB_TOKEN`/`GH_TOKEN` exists (the scheduled workflow
`.github/workflows/cve-snapshot.yml`) and baked into the snapshot. Without a
token `match` says "ghsa: skipped (no token)" instead of failing.

Pruning policy (keeps the committed snapshot small enough for git; also in
`knowledge/cve/README.md`): NVD/GHSA/OSV records only inside `--window-days`
(default 30), KEV additions inside `--kev-window-days` (default 365), and a
record is kept only if it is on KEV, is a MAL-* malicious-package advisory, has
a nuclei template, or scores at least `--min-cvss` (7.0) or `--min-epss`
(0.05). Descriptions are dropped, titles and reference lists are capped, and
OSV/GHSA version lists are reduced to ranges.
"""
import argparse, json, os, re, sys, time, urllib.error, urllib.parse, urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SNAPSHOT = ROOT / "knowledge" / "cve" / "snapshot.json"
SCHEMA = 1
UA = "mythos-cvefeed/1.0 (authorized security testing)"

KEV_URL = "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
EPSS_URL = "https://api.first.org/data/v1/epss"
NVD_URL = "https://services.nvd.nist.gov/rest/json/cves/2.0"
NUCLEI_URL = ("https://raw.githubusercontent.com/projectdiscovery/"
              "nuclei-templates/main/cves.json")
GHSA_URL = "https://api.github.com/advisories"
OSV_URL = "https://api.osv.dev/v1/query"

# Software that keeps producing unauthenticated RCE and gets exploited within
# hours of disclosure. `fingerprint` is where the version usually leaks — a
# hint for recon, not a promise: confirm it against the response you get.
