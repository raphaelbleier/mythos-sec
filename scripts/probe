#!/usr/bin/env python3
"""Mythos fast probe — read a target by hand, in one tool call.

The triage step of an engagement is mostly mechanical: fetch the entry point,
read the links and forms, collect the parameters, and say which bug class each
one suggests. Done through an agent that is many model round trips, and each
one costs latency the engagement does not get back. This does the mechanical
part deterministically and prints a compact surface map the agent can reason
about immediately.

  scripts/probe <url> [--depth 1] [--max 40] [--timeout 10] [--json]
                      [--header 'Cookie: a=b'] [--insecure]
  scripts/probe --selftest

It only issues GET requests to the host of <url> (and, with --depth 2, to links
on that same host), with one exception: GraphQL introspection sends a POST of the
fixed introspection query to /graphql. It sends no other body and no payloads: it
reports where a payload would go.
Scope still applies — the caller passes a URL that scope.yaml authorizes.
"""
import os
import pathlib
import time
import argparse, json, re, ssl, sys, urllib.error, urllib.parse, urllib.request
from collections import OrderedDict
from html.parser import HTMLParser

UA = "mythos-probe/1.0 (authorized security testing)"

# Parameter-name hints. A name is a hypothesis, never a finding: the probe says
# where to aim, the agent proves or drops it.
HINTS = [
    (r"^(q|query|s|search|keyword|term|name|title|msg|message|comment|text|body)$",
     "reflected-xss, sqli", "reflected into the page or into a query"),
    (r"^(id|uid|user|user_id|userid|username|user_name|email|account|order|order_id|doc|"
     r"docid|pid|item|num|uuid|guid|slug|handle)$",
     "idor/bola, sqli", "object reference: try another principal's value"),
    (r"(url|uri|link|next|redirect|redirect_uri|return|returnto|returnurl|dest|"
     r"destination|continue|callback|target|to|goto|r)$",
     "open-redirect, ssrf", "takes a location: off-site redirect or server-side fetch"),
    (r"(file|filename|path|template|page|view|doc|include|load|download|attachment)$",
     "path-traversal, lfi, ssti", "names something on disk or a template"),
    (r"^(cmd|command|exec|run|ping|host|ip|domain|lookup|dns)$",
     "command-injection, ssrf", "looks like it reaches a shell or the network"),
    (r"(token|jwt|auth|session|sig|signature|hmac|key|secret|password|passwd|pwd)$",
     "auth/jwt", "credential material: check algorithm, signature, expiry"),
    (r"(amount|price|qty|quantity|total|balance|discount|coupon|role|admin|is_admin|"
     r"status|state|level)$",
     "business-logic, mass-assignment", "value the server should own, not the client"),
    (r"(lang|locale|theme|format|type|sort|order_by|dir|debug|test)$",
     "misc", "low-value unless it reaches a sink"),
]

SECRET_RE = re.compile(
    r"(?i)\b(api[_-]?key|secret|passwd|password|token|bearer|aws_access_key_id|"
    r"private[_-]?key|BEGIN [A-Z ]*PRIVATE KEY)\b")
VERSION_RE = re.compile(r"(?i)\b([a-z][a-z0-9_.+-]{1,30})[/ ]v?(\d+\.\d+(?:\.\d+)?)")
INTERESTING_HEADERS = ("server", "x-powered-by", "x-aspnet-version", "via", "x-generator",
                       "access-control-allow-origin", "access-control-allow-credentials",
                       "content-security-policy", "strict-transport-security",
                       "x-content-type-options", "set-cookie", "location", "www-authenticate")
MISSING_HEADERS = ("content-security-policy", "strict-transport-security",
                   "x-content-type-options")
# Paths worth one GET each: cheap, high signal, no payload.
COMMON_PATHS = ("/robots.txt", "/.env", "/.git/config", "/sitemap.xml", "/openapi.json",
                "/swagger.json", "/static/openapi.json", "/api/openapi.json", "/v1/openapi.json",
                "/api-docs", "/graphql", "/api", "/admin", "/server-status",
                "/.well-known/security.txt")


class Links(HTMLParser):
    """Collect links, forms with their inputs, scripts and comments."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.links, self.scripts, self.comments = [], [], []
        self.forms, self._form = [], None

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == "a" and a.get("href"):
            self.links.append(a["href"])
        elif tag == "script" and a.get("src"):
            self.scripts.append(a["src"])
        elif tag == "form":
            self._form = {"action": a.get("action", ""),
                          "method": (a.get("method") or "get").lower(), "inputs": []}
        elif tag in ("input", "textarea", "select") and self._form is not None:
            self._form["inputs"].append({"name": a.get("name", ""),
                                         "type": a.get("type", tag)})
        elif tag == "form" and self._form:
            pass

    def handle_endtag(self, tag):
        if tag == "form" and self._form is not None:
            self.forms.append(self._form)
            self._form = None

    def handle_comment(self, data):
        if data.strip():
            self.comments.append(data.strip()[:200])


def hypotheses(name):
    for pattern, classes, why in HINTS:
        if re.search(pattern, name or "", re.I):
            return classes, why
    return "unknown", "no name hint: test what the response does with it"


def scope_rate(default=5.0):
    """requests per second from the engagement's scope file, not a guess.

    These scripts are one process making hundreds of requests, so the
    PreToolUse budget guard never sees them: it paces the agent's tool calls,
    not the loop inside one of them. Measuring the traffic showed this one
    running at 33 to 68 requests per second against a scope that authorized 20,
    which is the kind of thing that gets a tester removed from a program.

    The scope file is the authority. With no scope pinned, fall back to a rate
    low enough to be polite rather than to the machine's capacity.
    """
    path = os.environ.get("MYTHOS_SCOPE")
    if not path:
        return default
    try:
        text = pathlib.Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return default
    m = re.search(r"^\s*rate_limit_rps\s*:\s*([0-9.]+)", text, re.M)
    try:
        return float(m.group(1)) if m else default
    except (TypeError, ValueError):
        return default


_LAST = [0.0]
_MIN_GAP = [0.0]


def pace():
    """Hold the configured rate across every request this process makes."""
    gap = _MIN_GAP[0]
    if gap <= 0:
        return
    wait = _LAST[0] + gap - time.monotonic()
    if wait > 0:
        time.sleep(wait)
    _LAST[0] = time.monotonic()


def fetch(url, headers, timeout, insecure):
    pace()
    req = urllib.request.Request(url, headers={"User-Agent": UA, **headers})
    ctx = ssl._create_unverified_context() if insecure else None
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            body = r.read(400_000)
            return r.status, dict(r.headers), body.decode("utf-8", "replace"), r.geturl()
    except urllib.error.HTTPError as e:
        body = e.read(200_000) if e.fp else b""
        return e.code, dict(e.headers or {}), body.decode("utf-8", "replace"), url
    except Exception as e:                                  # DNS, TLS, refused, timeout
        return None, {}, f"{type(e).__name__}: {e}", url


INTROSPECT = ('{"query":"{__schema{queryType{fields{name args{name}}}'
              'mutationType{fields{name args{name}}}}}"}')


def from_graphql(url, headers, timeout, insecure, params):
    pace()
    """Schema fields as aim points, when the endpoint answers introspection.

    A GraphQL app maps to a handful of HTML pages while its whole surface sits behind one path.
    Without this the surface map misses everything that matters: on DVGA it listed 11 pages and
    none of the 21 documented vulnerabilities' entry points.
    """
    req = urllib.request.Request(url, data=INTROSPECT.encode(),
                                 headers={"User-Agent": UA, "Content-Type": "application/json",
                                          **headers})
    ctx = ssl._create_unverified_context() if insecure else None
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            doc = json.loads(r.read(400_000))
    except Exception:
        return []
    schema = ((doc.get("data") or {}).get("__schema") or {})
    out = []
    for kind in ("queryType", "mutationType"):
        for field in ((schema.get(kind) or {}).get("fields") or []):
            name = field.get("name")
            if not name:
                continue
            args = [a["name"] for a in (field.get("args") or []) if a.get("name")]
            out.append(f"{'query' if kind == 'queryType' else 'mutation'} {name}"
                       + (f"({', '.join(args)})" if args else ""))
            for a in args:
                params.setdefault(a, {"name": a, "seen_at": [], "example": "", "method": "POST"})
                params[a]["seen_at"].append(f"graphql {name} (arg)")
    return out


def from_openapi(doc, params):
    """Add every documented parameter and request-body field as an aim point."""
    endpoints = []
    for path, methods in (doc.get("paths") or {}).items():
        if not isinstance(methods, dict):
            continue
        for method, op in methods.items():
            if method.lower() not in ("get", "post", "put", "patch", "delete") \
                    or not isinstance(op, dict):
                continue
            endpoints.append(f"{method.upper()} {path}")
            for prm in op.get("parameters") or []:
                name = (prm or {}).get("name")
                if name:
                    params.setdefault(name, {"name": name, "seen_at": [], "example": "",
                                             "method": method.upper()})["seen_at"].append(
                        f"{method.upper()} {path} ({prm.get('in', '?')})")
            body = (((op.get("requestBody") or {}).get("content") or {})
                    .get("application/json") or {}).get("schema") or {}
            for field in (body.get("properties") or {}):
                params.setdefault(field, {"name": field, "seen_at": [], "example": "",
                                          "method": method.upper()})["seen_at"].append(
                    f"{method.upper()} {path} (body)")
    return endpoints


def probe(url, depth, max_pages, timeout, headers, insecure):
    origin = urllib.parse.urlsplit(url)
    base = f"{origin.scheme}://{origin.netloc}"
    seen, queue = set(), [url]
    pages, params, notes = [], OrderedDict(), []
    tech = set()

    while queue and len(pages) < max_pages:
        current = queue.pop(0)
        if current in seen:
            continue
        seen.add(current)
        status, hdrs, body, final = fetch(current, headers, timeout, insecure)
        if status is None:
            notes.append(f"{current}: unreachable ({body})")
            continue
        low = {k.lower(): v for k, v in hdrs.items()}
        page = {"url": current, "status": status, "bytes": len(body),
                "type": low.get("content-type", "").split(";")[0],
                "headers": {k: low[k] for k in INTERESTING_HEADERS if k in low}}
        if final != current:
            page["redirected_to"] = final

        for key, value in low.items():
            for m in VERSION_RE.finditer(value if key in ("server", "x-powered-by") else ""):
                tech.add(f"{m.group(1)}/{m.group(2)}")
        if SECRET_RE.search(body):
            page["secret_like"] = sorted({m.group(0).lower()
                                          for m in SECRET_RE.finditer(body)})[:6]
        missing = [h for h in MISSING_HEADERS if h not in low]
        if missing and page["type"].startswith("text/html"):
            page["missing_headers"] = missing
        cookie = low.get("set-cookie", "")
        if cookie:
            weak = [f for f in ("httponly", "secure", "samesite") if f not in cookie.lower()]
            if weak:
                page["weak_cookie_flags"] = weak

        # parameters already in the URL
        for name, values in urllib.parse.parse_qs(urllib.parse.urlsplit(current).query).items():
            params.setdefault(name, {"name": name, "seen_at": [], "method": "GET",
                                     "example": values[0][:40]})["seen_at"].append(current)

        if page["type"].startswith(("text/html", "application/xhtml")):
            parser = Links()
            try:
                parser.feed(body)
            except Exception:
                pass
            page["forms"] = parser.forms
            for form in parser.forms:
                action = urllib.parse.urljoin(current, form["action"] or current)
                for field in form["inputs"]:
                    if field["name"]:
                        params.setdefault(field["name"], {
                            "name": field["name"], "seen_at": [], "example": "",
                            "method": form["method"].upper()})["seen_at"].append(action)
            if parser.comments:
                page["html_comments"] = parser.comments[:5]
            if parser.scripts:
                page["scripts"] = parser.scripts[:10]
            for href in parser.links:
                target = urllib.parse.urljoin(current, href)
                if target.startswith(base) and target not in seen and depth > 1:
                    queue.append(target.split("#")[0])
                if target.startswith(base):
                    for name, values in urllib.parse.parse_qs(
                            urllib.parse.urlsplit(target).query).items():
                        params.setdefault(name, {"name": name, "seen_at": [], "method": "GET",
                                                 "example": values[0][:40]})[
                            "seen_at"].append(target.split("?")[0])
        pages.append(page)

    # cheap common-path sweep on the origin
    extra, endpoints = [], []
    for path in COMMON_PATHS:
        status, hdrs, body, _ = fetch(base + path, headers, timeout, insecure)
        # A GraphQL endpoint answers GET with 400 ("must provide a query string"), so introspect
        # it before the status filter drops the row: the schema is the whole surface of such an app.
        gql = (from_graphql(base + path, headers, timeout, insecure, params)
               if path == "/graphql" and status else [])
        if gql:
            endpoints += gql
        if status and status not in (404, 405, 501) and not (status == 400 and path == "/graphql"
                                                            and not gql):
            row = {"path": path, "status": status, "bytes": len(body)}
            if SECRET_RE.search(body):
                row["secret_like"] = True
            if gql:
                row["graphql_fields"] = len(gql)
            if path.endswith(("openapi.json", "swagger.json")):
                try:
                    doc = json.loads(body)
                    if isinstance(doc, dict) and (doc.get("openapi") or doc.get("swagger")):
                        spec = from_openapi(doc, params)
                        endpoints += [e for e in spec if e not in endpoints]
                        row["endpoints"] = len(spec)
                except ValueError:
                    pass
            extra.append(row)

    for info in params.values():
        info["hypotheses"], info["why"] = hypotheses(info["name"])
        if info["hypotheses"] == "unknown" and any("(path)" in x for x in info["seen_at"]):
            # a value in the path addresses an object: that is an access-control question
            info["hypotheses"] = "idor/bola"
            info["why"] = "path segment addressing an object: try another principal's value"
        info["seen_at"] = sorted(set(info["seen_at"]))[:4]
    return {"target": url, "origin": base, "pages": pages, "parameters": list(params.values()),
            "reachable_paths": extra, "api_endpoints": endpoints,
            "technology": sorted(tech), "notes": notes}


def render(result):
    out = [f"# surface of {result['target']}", ""]
    for page in result["pages"]:
        line = f"{page['status']} {page['url']}  {page['bytes']}B {page['type']}"
        out.append(line)
        for key in ("redirected_to", "secret_like", "missing_headers", "weak_cookie_flags",
                    "html_comments", "scripts"):
            if page.get(key):
                out.append(f"    {key}: {page[key]}")
        for header, value in page.get("headers", {}).items():
            out.append(f"    {header}: {value[:120]}")
        for form in page.get("forms", []):
            fields = ", ".join(f"{i['name']}:{i['type']}" for i in form["inputs"] if i["name"])
            out.append(f"    form {form['method'].upper()} {form['action'] or '(self)'} [{fields}]")
    if result["reachable_paths"]:
        out += ["", "## reachable common paths"]
        out += [f"{r['status']} {r['path']}  {r['bytes']}B"
                + ("  SECRET-LIKE" if r.get("secret_like") else "")
                for r in result["reachable_paths"]]
    if result.get("api_endpoints"):
        out += ["", f"## documented API endpoints ({len(result['api_endpoints'])})"]
        out += result["api_endpoints"][:60]
        if len(result["api_endpoints"]) > 60:
            out.append(f"... and {len(result['api_endpoints']) - 60} more")
    if result["technology"]:
        out += ["", "## technology", ", ".join(result["technology"])]
    if result["parameters"]:
        out += ["", "## parameters, ranked hypothesis first", ""]
        known = [p for p in result["parameters"] if p["hypotheses"] != "unknown"]
        rest = [p for p in result["parameters"] if p["hypotheses"] == "unknown"]
        verbs = ("GET ", "POST ", "PUT ", "PATCH ", "DELETE ")
        for p in known + rest:
            # the location line already carries the verb for spec-derived parameters
            spec = p["seen_at"] and p["seen_at"][0].startswith(verbs)
            method = "" if spec else f" ({p['method']})"
            out.append(f"- `{p['name']}`{method} -> {p['hypotheses']}")
            out.append(f"  {p['why']}")
            out.append(f"  at {p['seen_at'][0] if p['seen_at'] else '?'}")
    if result["notes"]:
        out += ["", "## notes"] + result["notes"]
    out += ["", "Hypotheses are aim points, not findings. Prove each one with a single "
            "request and keep the request/response pair as evidence."]
    return "\n".join(out)


def _selftest() -> int:
    """Asserts over the parsers, with no network.

    The surface map is the backbone of an engagement: the verdict ledger counts
    endpoints from it, so a parser that quietly drops a form or a parameter
    shrinks the whole run without any error appearing. These are the three
    readers whose output becomes that count.
    """
    failures = []

    def want(got, expect, label):
        if got != expect:
            failures.append(f"{label}: got {got!r}, want {expect!r}")

    # HTML
    page = Links()
    page.feed("""<html><!-- TODO: remove debug token abc -->
      <a href="/login">in</a><a href="/admin?id=1">admin</a>
      <script src="/static/app.js"></script>
      <form action="/doLogin" method="POST">
        <input name="user" type="text"><input name="pw" type="password">
        <textarea name="note"></textarea><select name="role"></select>
      </form></html>""")
    want(page.links, ["/login", "/admin?id=1"], "both links")
    want(page.scripts, ["/static/app.js"], "script sources")
    want(len(page.forms), 1, "one form")
    want(page.forms[0]["action"], "/doLogin", "form action")
    want(page.forms[0]["method"], "post", "method lowercased")
    want([i["name"] for i in page.forms[0]["inputs"]], ["user", "pw", "note", "role"],
         "input, textarea and select all count as parameters")
    want(any("debug token" in c for c in page.comments), True, "comments kept")

    # A form with no action posts back to the page it is on, and an unclosed form
    # must still be reported: both shapes appear in real applications.
    page2 = Links()
    page2.feed('<form><input name="q"></form><form action="/x"><input name="y">')
    want(len(page2.forms), 1, "an unclosed form is not emitted, the closed one is")
    want(page2.forms[0]["action"], "", "a missing action is empty, not dropped")

    # OpenAPI
    params = {}
    endpoints = from_openapi({"paths": {
        "/users/{id}": {"get": {"parameters": [{"name": "id", "in": "path"}]}},
        "/register": {"post": {"requestBody": {"content": {"application/json": {
            "schema": {"properties": {"email": {}, "admin": {}}}}}}}},
        "/ignored": "not a dict",
    }}, params)
    want(any("/users/{id}" in e for e in endpoints), True, "path endpoint found")
    want(any("/register" in e for e in endpoints), True, "body endpoint found")
    want("id" in params and "email" in params and "admin" in params, True,
         "path parameters and body fields both become aim points")

    # Class hints
    want(hypotheses("redirect_url")[0] != "unknown", True, "a known name suggests a class")
    want(hypotheses("zzz_nothing")[0], "unknown", "an unknown name says so")

    for f in failures:
        print(f"FAIL {f}")
    print(f"probe selftest: {len(failures)} failure(s)")
    return 1 if failures else 0


def main():
    if "--selftest" in sys.argv[1:]:
        return _selftest()
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("url")
    ap.add_argument("--depth", type=int, default=1, help="1 = entry point only, 2 = follow links")
    ap.add_argument("--max", type=int, default=40, dest="max_pages")
    ap.add_argument("--timeout", type=float, default=10)
    ap.add_argument("--header", action="append", default=[], help="'Name: value', repeatable")
    ap.add_argument("--insecure", action="store_true", help="skip TLS verification")
    ap.add_argument("--rate", type=float, default=None,
                    help="requests per second, 0 = unlimited. The default comes from "
                         "rules.rate_limit_rps in $MYTHOS_SCOPE, else 5.")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    rate = scope_rate() if a.rate is None else a.rate
    _MIN_GAP[0] = 1.0 / rate if rate and rate > 0 else 0.0
    headers = {}
    for h in a.header:
        name, sep, value = h.partition(":")
        if not sep or not name.strip():
            raise SystemExit(f"probe: bad --header {h!r}: expected 'Name: value'")
        headers[name.strip()] = value.strip()
    result = probe(a.url, a.depth, a.max_pages, a.timeout, headers, a.insecure)
    print(json.dumps(result, indent=1) if a.json else render(result))
    return 0 if result["pages"] else 1


if __name__ == "__main__":
    sys.exit(main())
